# PrintForge environment. Copy to .env.local for development.
# Every provider defaults to its in-repo mock; the app runs with NO env at all.
# Lines marked OWNER DECISION REQUIRED need real values before launch (plan §8).

APP_URL=http://localhost:3000

# Supabase (required from Session 3 onward)
# OWNER DECISION REQUIRED: production Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI generation: mock | meshy
# OWNER DECISION REQUIRED: Meshy account, budget, and rate limits
GENERATION_PROVIDER=mock
MESHY_API_KEY=

# Payments: mock | dodo  (Dodo Payments — Stripe is unavailable in India)
# OWNER DECISION REQUIRED: Dodo account, live keys, webhook secret, and the
# "Custom 3D Print" pay-what-you-want product id. Confirm physical-goods MoR terms.
PAYMENT_PROVIDER=mock
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=
DODO_ENV=test_mode

# Slicing: mock | prusa
# OWNER DECISION REQUIRED: approved slicer profiles and PrusaSlicer install
SLICER=mock
PRUSA_SLICER_PATH=

# Printer gateway: mock | octoprint
# OWNER DECISION REQUIRED: printer fleet config JSON (never exposed to clients)
# Keyed by printers.id, one entry per bay. Server-only: `npm run check:bundle`
# fails the build if this name or value ever reaches a client bundle.
#   {"prn_01K0PRNSEED000000000000001":{"baseUrl":"http://octopi-bay1.local","apiKey":"..."}}
PRINTER_GATEWAY=mock
PRINTER_GATEWAY_CONFIG=

# Email: mock | resend
# OWNER DECISION REQUIRED: sending domain and Resend API key
EMAIL=mock
RESEND_API_KEY=
